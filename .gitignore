# Ignore everything by default to protect proprietary assets, then whitelist code
*

# Allow repo documentation and configs
!.gitignore
!README.md
!CLAUDE.md

# Allow Python code and projects
!*.py
!System1/
!System1/**
!System2/
!System2/**
!Trial codes/
!Trial codes/**
!mv_codes/
!mv_codes/**

# Ignore temporary and build caches
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.gemini/
scratch/
