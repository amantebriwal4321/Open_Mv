# Ignore binary assets, videos, zips, PDFs, compiled bytecode, and test datasets
*.pdf
*.mp4
*.jpeg
*.jpg
*.zip
*.mpy
*.py[cod]
*$py.class
__pycache__/
.vscode/
.idea/
.gemini/
scratch/
System1/uncertain_images/
Camera_Videos/

# --- company material: NOT ours to publish ---
# The working folder also holds the employer's machine CAD, internal
# specification decks and factory photos.  The patterns above miss these
# two, so they are named explicitly.
*.pptx
*.stp
*.docx
~$*

# Folders produced by unpacking the company decks/zips: these hold factory
# photos (.png) and the vendor's compiled modules.  .png is not covered by
# the rules above, so name the folders explicitly.
_extracted/
_imgsys/
_pptx/

# OpenMV IDE autosave scratch files
*.autosave

# frames saved from the IDE for offline analysis - working data, not source
empty*.png
chili*.png
*_320.png
